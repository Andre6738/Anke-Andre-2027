rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // RSVP-antwoorde.
    // - Enigeen mag 'n geldige RSVP skep (die publieke vorm).
    // - Slegs die admin (e-pos in die lys hieronder) mag lees.
    // - Niemand mag via die klient opdateer of verwyder nie.
    match /rsvps/{doc} {
      allow create: if isValidRsvp(request.resource.data);
      allow read: if request.auth != null
                  && request.auth.token.email in ['andrec06112001@gmail.com'];
      allow update, delete: if false;
    }

    function isValidRsvp(d) {
      return d.naam is string && d.naam.size() > 0 && d.naam.size() < 120
          && d.epos is string && d.epos.size() < 200
          && d.bywoon in ['ja', 'nee']
          && d.aantalGaste is int && d.aantalGaste >= 0 && d.aantalGaste < 30
          && d.selfoon is string
          && d.dieet is string
          && d.liedjie is string && d.liedjie.size() < 300
          && d.boodskap is string && d.boodskap.size() < 1000;
    }
  }
}
