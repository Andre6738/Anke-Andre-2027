rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // RSVP-antwoorde.
    // - Enigeen mag 'n geldige RSVP skep (die publieke vorm).
    // - Slegs die admin (e-pos in die lys hieronder) mag lees.
    // - Niemand mag via die klient opdateer of verwyder nie.
    match /rsvps/{doc} {
      allow create: if isValidRsvp(request.resource.data);
      allow read: if request.auth != null
                  && request.auth.token.email in ['andrec06112001@gmail.com'];
      allow update, delete: if false;
    }

    function isValidRsvp(d) {
      return d.naam is string && d.naam.size() > 0 && d.naam.size() < 80
          && d.van is string && d.van.size() > 0 && d.van.size() < 80
          && d.selfoon is string && d.selfoon.size() > 0 && d.selfoon.size() < 40
          && d.bywoon in ['ja', 'nee']
          && d.gaste is list && d.gaste.size() < 30
          && d.liedjies is list && d.liedjies.size() < 30;
    }
  }
}
